# Backend (read by backend/app/core/config.py; copy to backend/.env)
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# Only needed for Earthdata datasets that require login; NASA POWER is keyless.
NASA_EARTHDATA_TOKEN=
# For scripts/fetch_appeears.py (MODIS NDVI, SMAP). Free account: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
HTTP_TIMEOUT_SECONDS=30
NASA_CACHE_TTL_SECONDS=21600
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# Frontend (copy to frontend/.env); defaults to /api via the Vite dev proxy
VITE_API_BASE_URL=/api
